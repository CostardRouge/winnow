{
  "name": "winnow",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "description": "Media management tool (ingest / cull / export) — indexes, culls and exports the NAS RAW/videos without ever touching the originals more than once.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx scripts/build-agent-bridge.ts && next dev",
    "build": "tsx scripts/build-agent-bridge.ts && next build",
    "agent-bridge": "tsx scripts/build-agent-bridge.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "migrate": "tsx src/lib/migrate.ts",
    "worker": "WINNOW_PROCESS=worker tsx src/worker.ts",
    "scan": "tsx src/scripts/scan.ts",
    "geocode-backfill": "tsx src/scripts/geocode-backfill.ts",
    "ml-backfill": "tsx src/scripts/ml-backfill.ts",
    "people-backfill": "tsx src/scripts/people-backfill.ts",
    "srt-backfill": "tsx src/scripts/srt-backfill.ts",
    "capture-days": "tsx src/scripts/capture-days.ts",
    "device-probe": "tsx src/scripts/device-probe.ts",
    "shutter-backfill": "tsx src/scripts/shutter-backfill.ts",
    "relink-moved": "tsx src/scripts/relink-moved.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@photostructure/tz-lookup": "^11.6.0",
    "bullmq": "^6.3.16",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "exiftool-vendored": "^39.0.1",
    "geist": "^1.7.2",
    "heic-decode": "^2.1.0",
    "ioredis": "^6.0.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-window": "^2.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/heic-decode": "^2.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "sharp": "^0.35.5"
  }
}
